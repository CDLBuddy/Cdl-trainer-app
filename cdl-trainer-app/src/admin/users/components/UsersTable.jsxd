// Path: src/admin/dashboard/components/UsersTable.jsx
import React, { memo, useMemo } from 'react'

/**
 * One row in the users table.
 * Separated + memoized so large lists re-render less often.
 */
const UserRow = memo(function UserRow({
  u,
  styles,
  instructorList,
  expirySoon,
  clampPct,
  onUpdateUser,
  onRemoveUser,
}) {
  const warnPermit = expirySoon(u.permitExpiry)
  const warnMed    = expirySoon(u.medCardExpiry)

  return (
    <tr className={warnPermit ? styles.rowWarn : undefined}>
      <td>{u.name}</td>
      <td style={{ fontFamily: 'ui-monospace, SFMono-Regular, Menlo, monospace' }}>{u.email}</td>

      <td>
        <label className="visually-hidden" htmlFor={`role-${u.email}`}>Role</label>
        <select
          id={`role-${u.email}`}
          className="u-select is-sm"
          value={u.role}
          onChange={e => onUpdateUser(u.email, { role: e.target.value })}
          aria-label={`Role for ${u.email}`}
        >
          <option value="student">Student</option>
          <option value="instructor">Instructor</option>
          <option value="admin">Admin</option>
        </select>
      </td>

      <td>
        <label className="visually-hidden" htmlFor={`company-${u.email}`}>Company</label>
        <input
          id={`company-${u.email}`}
          className="u-input is-sm"
          type="text"
          value={u.assignedCompany}
          onChange={e => onUpdateUser(u.email, { assignedCompany: e.target.value })}
          placeholder="(Company)"
          aria-label={`Company for ${u.email}`}
        />
      </td>

      <td>
        <label className="visually-hidden" htmlFor={`instructor-${u.email}`}>Assigned instructor</label>
        <select
          id={`instructor-${u.email}`}
          className="u-select is-sm"
          value={u.assignedInstructor}
          onChange={e => onUpdateUser(u.email, { assignedInstructor: e.target.value })}
          aria-label={`Instructor for ${u.email}`}
        >
          <option value="">(None)</option>
          {instructorList.map(inst => (
            <option key={inst.email} value={inst.email}>{inst.name}</option>
          ))}
        </select>
      </td>

      <td title={`${clampPct(u.profileProgress)}%`}>
        {clampPct(u.profileProgress)}%
      </td>

      <td className={warnPermit ? styles.expiry : undefined} title={u.permitExpiry || ''}>
        {u.permitExpiry || '—'}
      </td>

      <td className={warnMed ? styles.expiry : undefined} title={u.medCardExpiry || ''}>
        {u.medCardExpiry || '—'}
      </td>

      <td>{u.paymentStatus || '—'}</td>

      <td style={{ whiteSpace: 'nowrap' }}>
        <button
          className="btn outline"
          onClick={() => onRemoveUser(u.email)}
          aria-label={`Remove ${u.email}`}
          title="Remove user"
        >
          Remove
        </button>
      </td>
    </tr>
  )
})

/**
 * UsersTable
 * Props (unchanged):
 *   - styles (CSS module from AdminDashboard)
 *   - rows (array of users)
 *   - instructorList (array)
 *   - expirySoon (fn)
 *   - clampPct (fn)
 *   - onUpdateUser (fn)
 *   - onRemoveUser (fn)
 */
function UsersTable({
  styles, rows, instructorList, expirySoon, clampPct,
  onUpdateUser, onRemoveUser,
}) {
  // Stable, deduped instructors (protect against accidental dupes)
  const safeInstructors = useMemo(() => {
    const seen = new Set()
    return instructorList.filter(i => {
      const key = i.email || i.name
      if (!key || seen.has(key)) return false
      seen.add(key)
      return true
    })
  }, [instructorList])

  return (
    <div className={styles.tableWrap}>
      <table className={styles.table} role="table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Role</th>
            <th scope="col">Company</th>
            <th scope="col">Assigned Instructor</th>
            <th scope="col">Profile %</th>
            <th scope="col">Permit Exp.</th>
            <th scope="col">MedCard Exp.</th>
            <th scope="col">Payment</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>

        <tbody>
          {rows.map(u => (
            <UserRow
              key={u.email}
              u={u}
              styles={styles}
              instructorList={safeInstructors}
              expirySoon={expirySoon}
              clampPct={clampPct}
              onUpdateUser={onUpdateUser}
              onRemoveUser={onRemoveUser}
            />
          ))}

          {rows.length === 0 && (
            <tr>
              <td colSpan={10} style={{ textAlign: 'center', opacity: 0.8 }}>
                No users found.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  )
}

export default memo(UsersTable)